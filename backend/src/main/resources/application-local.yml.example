# 本地配置模板（本文件入库，可公开）
#
# 用法：
#   cp backend/src/main/resources/application-local.yml.example \
#      backend/src/main/resources/application-local.yml
#   然后把下面的 api-key 换成你自己的密钥。
#   application-local.yml 已在 .gitignore 里，不会进仓库。
#
# 另一种方式：不建这个文件，直接设环境变量 DEEPSEEK_API_KEY（application.yml 已读它）。
#
# 启动：bash scripts/dev.sh —— 脚本检测到 application-local.yml 会自动加 --spring.profiles.active=local

app:
  llm:
    api-key: "在这里填你的 DeepSeek API Key"
